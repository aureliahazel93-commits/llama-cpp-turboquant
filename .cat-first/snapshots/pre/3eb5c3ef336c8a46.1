{
  "project": "llama.cpp",
  "repository": "https://github.com/ggml-org/llama.cpp",
  "build_system": "cmake",
  "description": "Hardware probe and backend mapping configuration for automated llama.cpp builds.",
  "probes": [
    {
      "backend": "CUDA",
      "target_devices": ["Nvidia GPU"],
      "os_support": ["Linux", "Windows"],
      "probe_commands": [
        "nvidia-smi",
        "nvcc --version"
      ],
      "cmake_flags": ["-DGGML_CUDA=ON"],
      "priority": 1,
      "fallback": "Vulkan"
    },
    {
      "backend": "Metal",
      "target_devices": ["Apple Silicon"],
      "os_support": ["macOS"],
      "probe_commands": [
        "sysctl -a | grep machdep.cpu.brand_string | grep 'Apple'",
        "system_profiler SPDisplaysDataType | grep 'Metal'"
      ],
      "cmake_flags": ["-DGGML_METAL=ON"],
      "priority": 1,
      "fallback": null
    },
    {
      "backend": "HIP",
      "target_devices": ["AMD GPU"],
      "os_support": ["Linux", "Windows"],
      "probe_commands": [
        "rocminfo",
        "rocm-smi"
      ],
      "cmake_flags": ["-DGGML_HIPBLAS=ON"],
      "priority": 2,
      "fallback": "Vulkan"
    },
    {
      "backend": "SYCL",
      "target_devices": ["Intel GPU"],
      "os_support": ["Linux", "Windows"],
      "probe_commands": [
        "sycl-ls",
        "clinfo"
      ],
      "cmake_flags": ["-DGGML_SYCL=ON"],
      "priority": 3,
      "fallback": "OpenVINO"
    },
    {
      "backend": "Vulkan",
      "target_devices": ["GPU (Cross-vendor fallback)"],
      "os_support": ["Linux", "Windows", "macOS", "Android"],
      "probe_commands": [
        "vulkaninfo --summary"
      ],
      "cmake_flags": ["-DGGML_VULKAN=ON"],
      "priority": 4,
      "fallback": "CPU"
    },
    {
      "backend": "MUSA",
      "target_devices": ["Moore Threads GPU"],
      "os_support": ["Linux"],
      "probe_commands": [
        "musa-smi"
      ],
      "cmake_flags": ["-DGGML_MUSA=ON"],
      "priority": 5,
      "fallback": "CPU"
    },
    {
      "backend": "CANN",
      "target_devices": ["Ascend NPU"],
      "os_support": ["Linux"],
      "probe_commands": [
        "npu-smi info"
      ],
      "cmake_flags": ["-DGGML_CANN=ON"],
      "priority": 6,
      "fallback": "CPU"
    },
    {
      "backend": "OpenVINO",
      "target_devices": ["Intel CPUs, GPUs, and NPUs"],
      "os_support": ["Linux", "Windows"],
      "probe_commands": [
        "cat /proc/cpuinfo | grep -i intel"
      ],
      "cmake_flags": ["-DGGML_OPENVINO=ON"],
      "priority": 7,
      "fallback": "BLAS"
    }
  ],
  "cpu_fallbacks": [
    {
      "backend": "BLAS",
      "description": "Standard CPU acceleration (OpenBLAS/BLIS)",
      "cmake_flags": ["-DGGML_BLAS=ON"]
    },
    {
      "backend": "Native",
      "description": "Native CPU instruction set optimization (AVX/AVX2/AVX512/ARM NEON)",
      "cmake_flags": ["-DGGML_NATIVE=ON"]
    }
  ],
  "build_instructions": {
    "clone": "git clone https://github.com/ggml-org/llama.cpp",
    "configure": "cmake -B build {DYNAMIC_CMAKE_FLAGS}",
    "compile": "cmake --build build --config Release"
  }
}
